use GFX.Application
use GFX.Color
use GFX.Rendering.FrameGraph
use GFX.GPU
use GFX.Rendering.Stats
use GFX.Rendering.Capture.Capture
use GFX.Rendering.Capture.CaptureQueue
use GFX.Window
use STD.Path

struct RegisteredPass {
    let name:str
    let execute:func(@GPU.RenderPass, @Application)
}

public class Renderer {
    private let clear:Color
    private let presentation:bool
    private var frame_graph:FrameGraph
    private let output:FrameGraph.Texture
    private var depth:FrameGraph.Texture? = null
    private var passes:RegisteredPass[]
    private var current_stats:Stats
    private var needs_depth:bool
    private var samples:GPU.Samples
    private var physical_color:GPU.Texture? = null
    private var physical_depth:GPU.Texture? = null
    private var color_format:GPU.TextureFormat? = null
    private var depth_width:int
    private var depth_height:int
    private var captures:CaptureQueue? = null

    init(
        clear:Color = Color(r:0.055, g:0.075, b:0.105, a:1.0),
        presentation:bool = true
    ) {
        var graph = FrameGraph()
        self.output = graph.import_texture(
            "GFX.Output",
            FrameGraph.TextureDescriptor(
                GPU.TextureFormat.invalid,
                GPU.TextureUsage.as_color_target()
            )
        )
        self.clear = clear
        self.presentation = presentation
        self.frame_graph = graph
        self.passes = []
        self.current_stats = Stats()
        self.needs_depth = false
        self.samples = GPU.Samples.one
        self.depth_width = 0
        self.depth_height = 0
    }

    func graph() FrameGraph { return self.frame_graph }
    func output_texture() FrameGraph.Texture { return self.output }
    func depth_texture() FrameGraph.Texture? { return self.depth }
    func stats() Stats { return self.current_stats }
    func sample_count() GPU.Samples { return self.samples }
    func presentation_enabled() bool { return self.presentation }

    // Capture the next complete render. The queue and worker are created only
    // when capture is requested; the ordinary render path does no readback.
    func capture_png(path:str) Result<Capture, str> {
        if path == "" { return Result<Capture, str>.failure("PNG output path cannot be empty") }
        try Path.validate(path) else error { return Result<Capture, str>.failure(error.detail) }
        if self.captures == null { self.captures = CaptureQueue() }
        if var captures = self.captures { return (try captures.request(path)) }
        return Result<Capture, str>.failure("could not create the capture queue")
    }

    module func close_captures() {
        if var captures = self.captures { captures.close() }
        self.captures = null
    }

    package func requires_depth() bool { return self.needs_depth }
    package func set_samples(value:GPU.Samples) { self.samples = value }

    // An offline exporter advances fences and encoding independently of drawing.
    package func progress_captures() {
        if var captures = self.captures { captures.progress() }
    }

    func add_pass(
        name:str,
        execute:func(@GPU.RenderPass, @Application),
        depth:bool = false
    ) FrameGraph.Pass {
        let pass = self.frame_graph.add_pass(name)
        self.frame_graph.read_write(pass, self.output)
        if depth {
            if self.depth == null {
                self.depth = self.frame_graph.create_texture(
                    "GFX.Depth",
                    FrameGraph.TextureDescriptor(
                        GPU.TextureFormat.depth16,
                        GPU.TextureUsage.as_depth_target()
                    )
                )
            }
            if let target = self.depth { self.frame_graph.write(pass, target) }
            self.needs_depth = true
        }
        self.passes.append(RegisteredPass(name:name, execute:execute))
        return pass
    }

    module func render(
        device:@GPU.Device,
        surface:@GPU.Surface,
        application:Application
    ) {
        var graph = self.frame_graph
        graph.require_compiled()
        var depth_target:GPU.DepthTarget? = null
        var window = application.resources().get<Window>()
        let size = window.pixel_size()
        var capture_frame = false
        if var captures = self.captures {
            captures.progress()
            capture_frame = captures.needs_frame()
            if capture_frame {
                let format = surface.format()
                let width = size.x as int
                let height = size.y as int
                if let error = capture_error(format, width, height) {
                    captures.fail(error)
                    capture_frame = false
                }
            }
        }
        match (try self.ensure_color(
            device,
            surface.format(),
            size.x as int,
            size.y as int,
            capture_frame
        )) {
            failure(error) => {
                if var captures = self.captures { captures.fail(error) }
                capture_frame = false
                self.ensure_color(device, surface.format(), size.x as int, size.y as int)
            }
            success => {}
        }
        var capture_output:GPU.Texture? = null
        if capture_frame {
            if self.samples == GPU.Samples.one {
                capture_output = self.physical_color
            } else {
                match (try device.texture(GPU.TextureSettings(
                    format:surface.format(), width:size.x as int, height:size.y as int,
                    usage:GPU.TextureUsage(sampled:true, color_target:true),
                    name:"GFX resolved capture"
                ))) {
                    failure(error) => {
                        if var captures = self.captures { captures.fail(error) }
                        capture_frame = false
                    }
                    success(texture) => { capture_output = texture }
                }
            }
        }
        if self.needs_depth {
            self.ensure_depth(device, size.x as int, size.y as int)
            if let texture = self.physical_depth {
                depth_target = GPU.DepthTarget(
                    texture:texture,
                    clear_depth:1.0,
                    depth_load:GPU.Load.clear,
                    depth_store:GPU.Store.preserve,
                    cycle:false
                )
            }
        }
        var commands = device.commands()
        if capture_frame {
            if let color = self.physical_color {
                var target = GPU.ColorTarget(
                    texture:color, clear:self.clear, load:GPU.Load.clear,
                    store:GPU.Store.preserve, cycle:false
                )
                if self.samples != GPU.Samples.one {
                    target.resolve = capture_output
                    target.store = GPU.Store.resolve
                }
                var targets:GPU.ColorTarget[] = [target]
                var pass = commands.render(targets, depth_target)
                self.execute(pass, graph, application)
                pass.finish()
                if self.presentation {
                    if let output = capture_output {
                        match (try commands.present(output, surface)) {
                            failure(error) => {
                                if var captures = self.captures { captures.fail(error) }
                            }
                            success(available) => {
                                if !available {
                                    if var captures = self.captures { captures.fail("capture surface is unavailable") }
                                }
                            }
                        }
                    }
                }
            }
        } elif !self.presentation {
            if let color = self.physical_color {
                var targets:GPU.ColorTarget[] = []
                targets.append(GPU.ColorTarget(
                    texture:color,
                    clear:self.clear,
                    load:GPU.Load.clear,
                    store:GPU.Store.preserve
                ))
                var pass = commands.render(targets, depth_target)
                self.execute(pass, graph, application)
                pass.finish()
            }
        } elif self.samples == GPU.Samples.one {
            if var pass = commands.render(surface, self.clear, depth_target) {
                self.execute(pass, graph, application)
                pass.finish()
            }
        } else {
            if let color = self.physical_color {
                if var pass = commands.render_resolved(
                    surface,
                    color,
                    self.clear,
                    depth_target
                ) {
                    self.execute(pass, graph, application)
                    pass.finish()
                }
            }
        }
        match (try commands.submit()) {
            failure(error) => {
                if capture_frame {
                    if var captures = self.captures { captures.fail(error) }
                    return
                }
                panic(error)
            }
            success => {}
        }
        if let output = capture_output {
            if var captures = self.captures { captures.submit(device, output, self.presentation) }
        }
        self.current_stats.record_frame(graph.plan_count(), device.command_stats())
    }

    private func execute(
        pass:@GPU.RenderPass,
        graph:@FrameGraph,
        application:Application
    ) {
        var index = 0
        while index < graph.plan_count() {
            let name = graph.pass_name(graph.plan_pass(index))
            let registered = self.require_pass(name)
            registered.execute(pass, application)
            index++
        }
    }

    private func ensure_color(
        device:@GPU.Device,
        format:GPU.TextureFormat,
        width:int,
        height:int,
        capture:bool = false
    ) Result<void, str> {
        if self.presentation && self.samples == GPU.Samples.one && !capture {
            self.physical_color = null
            self.color_format = format
            return Result<void, str>.success()
        }
        var resolved_width = width
        var resolved_height = height
        if resolved_width < 1 { resolved_width = 1 }
        if resolved_height < 1 { resolved_height = 1 }
        var format_matches = false
        if let current_format = self.color_format {
            format_matches = current_format == format
        }
        if let texture = self.physical_color {
            if texture.width() == resolved_width &&
                texture.height() == resolved_height &&
                texture.samples() == self.samples &&
                format_matches
            {
                return Result<void, str>.success()
            }
        }
        self.physical_color = try device.texture(GPU.TextureSettings(
            format:format,
            width:resolved_width,
            height:resolved_height,
            usage:GPU.TextureUsage(sampled:self.samples == GPU.Samples.one, color_target:true),
            samples:self.samples,
            name:frame_color_name(self.presentation),
            optimized_clear:self.clear
        )) else error { return Result<void, str>.failure(error) }
        self.color_format = format
        return Result<void, str>.success()
    }

    private func ensure_depth(device:@GPU.Device, width:int, height:int) {
        var resolved_width = width
        var resolved_height = height
        if resolved_width < 1 { resolved_width = 1 }
        if resolved_height < 1 { resolved_height = 1 }
        if let texture = self.physical_depth {
            if self.depth_width == resolved_width &&
                self.depth_height == resolved_height &&
                texture.samples() == self.samples
            {
                return
            }
        }
        self.physical_depth = device.texture(GPU.TextureSettings(
            format:GPU.TextureFormat.depth16,
            width:resolved_width,
            height:resolved_height,
            usage:GPU.TextureUsage.as_depth_target(),
            samples:self.samples,
            name:"GFX frame depth"
        ))
        self.depth_width = resolved_width
        self.depth_height = resolved_height
    }

    private func require_pass(name:str) RegisteredPass {
        for pass in self.passes { if pass.name == name { return pass } }
        panic("GFX.Rendering has no executor for FrameGraph pass '" + name + "'")
    }
}

func frame_color_name(presentation:bool) str {
    if presentation { return "GFX multisampled frame color" }
    return "GFX offscreen frame color"
}

package func capture_error(format:GPU.TextureFormat, width:int, height:int) str? {
    if width < 1 || height < 1 { return "capture surface has no pixels" }
    if format != GPU.TextureFormat.rgba8_unorm && format != GPU.TextureFormat.bgra8_unorm &&
        format != GPU.TextureFormat.rgba8_srgb && format != GPU.TextureFormat.bgra8_srgb {
        return "PNG capture requires an SDR RGBA8 or BGRA8 surface"
    }
    if width > 16 * 1024 * 1024 || ((width + 63) / 64) * 256 > (64 * 1024 * 1024) / height {
        return "PNG capture exceeds the 64 MiB transfer limit"
    }
    return null
}
