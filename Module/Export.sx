use GFX.Application
use GFX.Application.Session
use GFX.Rendering.Capture.Capture
use GFX.Rendering.Capture.State
use GFX.Rendering.Renderer
use GFX.Rendering.Plugin as RenderingPlugin
use GFX.Window
use STD.FileSystem
use STD.Path

package struct SequenceProgress { var completed:int = 0 }

// Offline export owns this Application's run interval. Each complete PNG is
// committed before the next simulation sample; no collection of frames grows.
public func export_png(
    application:Application,
    directory:str,
    frames:int,
    frames_per_second:int = 60,
    ready:(func(Application) bool)? = null
) Result<int, str> {
    if frames <= 0 || frames_per_second <= 0 {
        return Result<int, str>.failure("PNG export requires a positive frame count and frame rate")
    }
    if directory == "" { return Result<int, str>.failure("PNG export directory cannot be empty") }
    try Path.validate(directory) else error { return Result<int, str>.failure(error.detail) }
    // A fresh directory prevents mixing a successful prefix with older outputs.
    try FileSystem.create_directory(directory) else error {
        return Result<int, str>.failure("could not create new PNG export directory '" + directory + "': " + error.detail)
    }
    application.require_plugin(RenderingPlugin())
    var session = Session(application)
    var progress = SequenceProgress()
    let result = (try render_sequence(application, session, directory, frames, frames_per_second, ready, progress))
    session.close()
    return result
}

// Both public exports use exactly the same controlled samples. The MP4 caller
// retains the session while its encoder finishes and owns its private PNGs.
package func render_sequence(
    application:Application, session:Session, directory:str, frames:int,
    frames_per_second:int, ready:(func(Application) bool)?, progress:&SequenceProgress,
    width:int = 0, height:int = 0, label:str = "PNG",
    after_sample:(func(Application, int) Result<void, str>)? = null
) Result<int, str> {
    if let prepared = ready {
        while session.is_running() && !prepared(application) { session.poll() }
    }
    var failure:str? = null
    let interval = 1.0 / (frames_per_second as float)
    while progress.completed < frames && session.is_running() {
        try require_dimensions(application, width, height) else error { failure = error; break }
        let path = frame_path(directory, progress.completed)
        var ticket = try request_frame(application, path) else error { failure = error; break }
        var delta = interval
        if progress.completed == 0 { delta = 0.0 }
        try session.step(delta) else error { ticket.cancel(); failure = error; break }
        while ticket.state() == State.pending && session.is_running() {
            session.poll()
            if session.is_running() { progress_capture(application) }
        }
        if ticket.state() == State.completed {
            progress.completed++
            if let collect = after_sample {
                try collect(application, progress.completed - 1) else error { failure = error; break }
            }
            try require_dimensions(application, width, height) else error { failure = error; break }
        } else {
            if !session.is_running() { ticket.cancel(); break }
            if let error = ticket.error() { failure = error }
            else { failure = label + " export capture was cancelled" }
            break
        }
    }
    if let error = failure { return Result<int, str>.failure(label + " export stopped after $(progress.completed) frames: " + error) }
    if progress.completed != frames {
        return Result<int, str>.failure(label + " export cancelled after $(progress.completed) frames")
    }
    return Result<int, str>.success(progress.completed)
}

func require_dimensions(application:Application, width:int, height:int) Result<void, str> {
    if width == 0 { return Result<void, str>.success() }
    let size = application.resources().get<Window>().pixel_size()
    if size.x as int != width || size.y as int != height {
        return Result<void, str>.failure("MP4 export dimensions changed during capture")
    }
    return Result<void, str>.success()
}

func request_frame(application:Application, path:str) Result<Capture, str> {
    var resources = application.resources()
    var renderer = resources.get_mut<Renderer>()
    return (try renderer.capture_png(path))
}

func progress_capture(application:Application) {
    var resources = application.resources()
    var renderer = resources.get_mut<Renderer>()
    renderer.progress_captures()
}

package func frame_path(directory:str, index:int) str {
    var number = "$(index)"
    while number.count() < 6 { number = "0" + number }
    return directory + "/frame-" + number + ".png"
}
